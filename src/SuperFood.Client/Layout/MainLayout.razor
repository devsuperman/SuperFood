@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorized>
        <MudLayout>
            <MudAppBar Elevation="1">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                    OnClick="@((e) => _drawerOpen = !_drawerOpen)" />
                <MudText Typo="Typo.h6">SuperFood</MudText>
                <MudSpacer />
                <MudText Class="mr-4">@context.User.FindFirst("full_name")?.Value</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="LogoutAsync" />
            </MudAppBar>
            <MudDrawer @bind-Open="_drawerOpen" Elevation="2">
                <NavMenu />
            </MudDrawer>
            <MudMainContent>
                <MudContainer MaxWidth="MaxWidth.Large" Class="my-4">
                    @Body
                </MudContainer>
            </MudMainContent>
        </MudLayout>
    </Authorized>
</AuthorizeView>

@code {
    private bool _drawerOpen = true;

    [Inject] private Auth.AuthApiClient AuthApiClient { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private async Task LogoutAsync()
    {
        await AuthApiClient.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
